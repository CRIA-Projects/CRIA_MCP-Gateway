# Local HTTP listener. Netlify supplies the listener in production.
PORT=8787

# Identity is intentionally simple during the MVP. It must match an enabled
# user in src/access/configuration.ts. Replace it with verified Supabase Auth
# before exposing the gateway publicly.
MCP_GATEWAY_TRUSTED_CLIENT_ID=local-development-client

# Required in production to use the admin panel. Do not commit a real value.
# The local fallback is development-admin-key only when this variable is absent.
ADMIN_API_KEY=development-admin-key

# Optional. When both are set, the gateway persists access configuration and
# audit events in Supabase (tables cria_gateway_access_state / cria_gateway_audit_events,
# see supabase/migrations/0001_cria_gateway_persistence.sql) instead of Netlify
# Blobs / in-memory storage. SUPABASE_SERVICE_ROLE_KEY is a server-only secret:
# never expose it to the browser bundle or commit a real value.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
