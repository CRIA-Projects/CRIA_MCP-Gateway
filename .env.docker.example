# Generate a unique secret, at least 32 characters; never use the development key.
ADMIN_API_KEY=
# HTTPS proxy bind address: loopback or the server VPN interface IP. HTTP stays loopback-only.
CRIA_BIND_ADDRESS=127.0.0.1
CRIA_PORT=8787
# Only used when starting the optional `proxy` service (docker compose --profile https up).
CRIA_HTTPS_PORT=8443
CRIA_IMAGE=cria-mcp-gateway:local
