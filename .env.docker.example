# Generate a unique secret, at least 32 characters; never use the development key.
ADMIN_API_KEY=
# Keep loopback behind a local HTTPS proxy, or set the server's VPN interface IP.
CRIA_BIND_ADDRESS=127.0.0.1
CRIA_PORT=8787
# Only used when starting the optional `proxy` service (docker compose --profile https up).
CRIA_HTTPS_PORT=8443
CRIA_IMAGE=cria-mcp-gateway:local
# Empty = requests without x-client-id have no default user/access.
MCP_GATEWAY_TRUSTED_CLIENT_ID=
# Optional shared secret required as the x-api-key header on every /mcp request. Empty disables the check.
MCP_GATEWAY_API_KEY=
